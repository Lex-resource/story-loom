# =====================================================================
# novel-assistant 环境变量样例。
# 逐项与 config.py 对齐（tests/test_env_example_alignment.py 强制同步）：
# 新增 Settings 字段必须同步补到这里。
# 注意：数据库中的动态配置（系统设置页的 provider 等）优先级高于本文件。
# =====================================================================

# ---- App ----
# 生产必须保持 false：true 会把完整 prompt/response payload 同步落盘，
# 并在 500 响应里暴露异常详情。
DEBUG=false
# 逗号分隔的前端来源白名单
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000
# true 时放开本机以外的访问（部署态需自行加固）
ALLOW_REMOTE_ACCESS=false
# ALLOW_REMOTE_ACCESS=true 时远程 HTTP/WebSocket 请求必须携带此 token
REMOTE_ACCESS_TOKEN=

# ---- Database（必填，仅支持 PostgreSQL + asyncpg 驱动）----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/novel_assistant
# 逐条 SQL 回显（worker 每秒轮询会刷屏，保持关闭）
SQL_ECHO=false

# ---- LLM（兜底默认；运行时由 DB 里的 provider 配置覆盖）----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-v4-flash
# 完整请求+流式响应的墙钟上限（秒）
LLM_TIMEOUT=180
# 提取器后处理的总超时（秒），保证卡死任务可恢复
POST_PROCESSING_TIMEOUT_SECONDS=1200
# 主 provider 的重试预算（备份 provider 另有同等预算）
MAX_LLM_RETRIES=3
RETRY_DELAY=5

# ---- Embedding（空则回落 LLM_* / Chroma 内置本地模型）----
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ChromaDB 启动预热（读写探针 + embedding 会话建立），默认开。
# CHROMA_WARMUP_ENABLED=true

# ---- 目录（默认位于仓库 data/ 下，通常无需覆盖；保持注释即可用默认值）----
# CHROMA_PERSIST_DIR=
# LIVING_DOCS_DIR=
# DATA_DIR=
# SETTINGS_FILE=
# TOKENIZER_DIR=
# PROMPTS_DIR=
# LOG_DIR=
# FRONTEND_DIR=

# HuggingFace 镜像（离线 tokenizer 下载用）
HF_ENDPOINT=https://hf-mirror.com

# ---- Worker ----
# false（默认）= 单进程：API 进程内嵌 worker，start_backend.bat 即完整后端。
# true = 外部模式：独立 worker.py 进程消费 job（显式入口 start_worker.bat），
# 事件广播经 HTTP 回投 API。
# 警告：单进程模式下不要用 uvicorn --reload 启动后端 —— 每次热重载都会
# 重启内嵌 worker，丢掉内存中的在跑任务并留下孤儿 RUNNING 行。
DISABLE_IN_PROCESS_WORKER=false
WORKER_POLL_INTERVAL=5
MAX_CONCURRENT_JOBS=3
# 周期孤儿清理间隔（秒）
ORPHAN_CLEANUP_INTERVAL_SECONDS=300
# RUNNING 行多久没刷新视为孤儿（须大于单章串行 LLM 总耗时）
STALE_JOB_THRESHOLD_SECONDS=600
VECTOR_OUTBOX_LEASE_SECONDS=300
API_INTERNAL_URL=http://127.0.0.1:8000
# worker→API 广播鉴权 token。生产 MUST set（为空时仅允许 localhost 广播）
STREAM_INTERNAL_TOKEN=
INTERNAL_BROADCAST_PATH=/api/internal/broadcast

# ---- 功能开关 ----
ENABLE_LIGHT_POLISH=false
ENABLE_NOVEL_MEMORY_EVIDENCE=true
ENABLE_NOVEL_MEMORY_ATOMS=true
ENABLE_NOVEL_MEMORY_RECALL=true
# 生产保持 false：Chroma 向量 recall 是实验性能力
ENABLE_NOVEL_HYBRID_RECALL=false
ENABLE_NOVEL_MEMORY_SCENE_BLOCKS=true
ENABLE_NOVEL_NARRATIVE_INDEX=false
ENABLE_AUTO_EXTRACTOR_REVIEW=true
NOVEL_MEMORY_CONTEXT_MODE=layered
ENABLE_LEGACY_ISSUE_CLASSIFIER=false
# 研究专用：改它不影响生产行为（生产已冻结在 A28/V43，启动时会对偏离值告警）
NOVEL_CONTINUITY_PROMPT_VERSION=V43
