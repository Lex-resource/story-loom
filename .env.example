# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/novel_assistant
DISABLE_IN_PROCESS_WORKER=true

# LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Embedding
EMBEDDING_MODEL=text-embedding-3-small
# Optional: separate endpoint/key for embeddings (falls back to LLM_* when empty)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
